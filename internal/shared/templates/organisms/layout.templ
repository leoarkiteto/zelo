package organisms

import (
	"strings"

	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

// NavItem is a single sidebar navigation entry.
type NavItem struct {
	Label  string
	Path   string
	Active bool
}

// UserView is the signed-in user's identity shown in the topbar.
type UserView struct {
	Email   string
	Roles   []string
	Initial string
}

// ShellData carries everything the authenticated app shell needs to render.
// A nil shell renders the page without the topbar/sidebar (auth pages).
type ShellData struct {
	User   *UserView
	Nav    []NavItem
	CSRF   string
	Locale i18n.Language
}

templ Layout(title string, locale i18n.Language, shell *ShellData, body templ.Component) {
	<html lang={ locale }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{  title } · zelo</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
			// Load order is load-bearing: app.js registers the Alpine components
			// on `alpine:init`, and the Alpine CSP build calls Alpine.start() from
			// a microtask, which fires before the next deferred script runs. Keep
			// app.js ahead of alpine-csp.min.js — organisms_test.go locks this.
			<script src="/static/js/app.js" defer></script>
			<script src="/static/js/alpine-csp.min.js" defer></script>
		</head>
		<body>
			if shell != nil {
				@Shell(shell, body)
			} else {
				@body
			}
		</body>
	</html>
}

templ Shell(shell *ShellData, body templ.Component) {
	<div id="app-shell" lang={ shell.Locale } class="flex min-h-screen flex-col">
		<header class="topbar sticky top-0 z-40">
			<label for="nav-toggle" class="-ml-2 flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-md text-chrome-100 hover:bg-chrome-600 md:hidden" aria-label="Toggle navigation">
				@atoms.Icon(atoms.IconProps{Kind: atoms.IconKindMenu, Class: "h-6 w-6"})
			</label>
			<a href="/" class="flex items-center gap-2.5">
				<span class="flex h-9 w-9 items-center justify-center rounded-md bg-steel-500 text-base font-bold text-white">Z</span>
				<span class="leading-tight">
					<span class="block text-base font-bold tracking-wide">zelo</span>
					<span class="block text-[10px] font-medium uppercase tracking-widest text-chrome-200">{ i18n.T(shell.Locale, "topbar.brand_subtitle") }</span>
				</span>
			</a>
			<div class="flex-1"></div>
			if shell.User != nil {
				<div class="hidden items-center gap-3 sm:flex">
					<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-chrome-500 text-sm font-bold text-white">{ shell.User.Initial }</span>
					<span class="leading-tight">
						<a href="/profile" class="hover:underline">
							<span class="block max-w-[180px] truncate text-sm font-medium">{ shell.User.Email }</span>
						</a>
						<span class="block max-w-[220px] truncate text-xs text-chrome-300">{ strings.Join(shell.User.Roles, " · ") }</span>
					</span>
				</div>
				<form method="POST" action="/logout" class="ml-1">
					<input type="hidden" name="csrf_token" value={ shell.CSRF }/>
					<button class="btn btn-sm bg-white/10 text-white hover:bg-white/20" type="submit">{ i18n.T(shell.Locale, "topbar.sign_out") }</button>
				</form>
			}
		</header>
		<div class="flex flex-1">
			<input type="checkbox" id="nav-toggle" class="peer sr-only"/>
			<aside class="sidebar fixed inset-y-0 left-0 top-16 z-30 -translate-x-full transition-transform duration-200 peer-checked:translate-x-0 md:static md:z-auto md:translate-x-0">
				<nav class="py-3">
					<p class="nav-group">{ i18n.T(shell.Locale, "nav.group") }</p>
					<ul class="mx-2 space-y-1">
						for _, item := range shell.Nav {
							<li>
								<a class={ "nav-link", templ.KV("nav-link-active", item.Active) } href={ item.Path }>{ item.Label }</a>
							</li>
						}
					</ul>
				</nav>
			</aside>
			<label for="nav-toggle" class="fixed inset-0 z-20 hidden cursor-pointer bg-ink-950/40 peer-checked:block md:hidden"></label>
			<main class="min-w-0 flex-1">
				<div class="mx-auto max-w-6xl px-4 py-6 md:px-8 md:py-8">
					@body
				</div>
			</main>
		</div>
	</div>
}
