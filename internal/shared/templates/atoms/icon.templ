package atoms

templ Icon(p IconProps) {
	if p.DataIcon != "" {
		if p.Style != "" {
			<span class={ iconClass(p) } data-icon={ p.DataIcon } style={ p.Style } aria-hidden={ iconAriaHidden(p) }>{ materialName(p.Kind) }</span>
		} else {
			<span class={ iconClass(p) } data-icon={ p.DataIcon } aria-hidden={ iconAriaHidden(p) }>{ materialName(p.Kind) }</span>
		}
	} else {
		if p.Style != "" {
			<span class={ iconClass(p) } style={ p.Style } aria-hidden={ iconAriaHidden(p) }>{ materialName(p.Kind) }</span>
		} else {
			<span class={ iconClass(p) } aria-hidden={ iconAriaHidden(p) }>{ materialName(p.Kind) }</span>
		}
	}
}
