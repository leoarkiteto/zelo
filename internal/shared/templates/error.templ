package templates

import "github.com/leoarkiteto/zelo/internal/shared/i18n"

type ErrorPageData struct {
	Status  int
	Message string
	Locale  i18n.Language
}

templ ErrorPage(data ErrorPageData) {
	@Layout(i18n.T(data.Locale, "error.title"), data.Locale, nil, errorBody(data))
}

templ errorBody(data ErrorPageData) {
	<div class="flex min-h-screen flex-col items-center justify-center px-4">
		<span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-steel-500 text-xl font-bold text-white">Z</span>
		<h1 class="text-5xl font-bold tracking-tight text-ink-900">{ data.Status }</h1>
		<p class="mt-3 max-w-md text-center text-sm leading-relaxed text-ink-500">{ data.Message }</p>
		<a class="btn btn-primary mt-6" href="/">{ i18n.T(data.Locale, "error.go_to_dashboard") }</a>
	</div>
}
