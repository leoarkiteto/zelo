package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

// QuickAction is a dashboard quick-action card.
type QuickAction struct {
	Icon        string // building | mail | users | home | key
	Label       string
	Description string
	Path        string
}

type DashboardData struct {
	Shell        *organisms.ShellData
	Locale       i18n.Language
	Greeting     string
	Name         string
	Date         string
	Roles        []string
	QuickActions []QuickAction
}

templ DashboardPage(data DashboardData) {
	@organisms.Layout(i18n.T(data.Locale, "nav.dashboard"), data.Locale, data.Shell, dashboardBody(data))
}

templ dashboardBody(data DashboardData) {
	<div class="space-y-8">
		<section class="rounded-lg border border-steel-200 bg-canvas-blue p-6 md:p-8">
			<p class="text-sm font-medium text-steel-700">{ data.Greeting }, { data.Name }</p>
			<p class="mt-0.5 text-xs text-ink-500">{ data.Date }</p>
			<h1 class="mt-4 text-2xl font-bold tracking-tight text-ink-900">{ i18n.T(data.Locale, "home.dashboard_title") }</h1>
			<p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-600">
				{ i18n.T(data.Locale, "home.dashboard_subtitle") }
			</p>
			<div class="mt-5">
				if len(data.QuickActions) > 0 {
					<a class="btn btn-primary" href={ data.QuickActions[0].Path }>
						{ i18n.T(data.Locale, "home.get_started") }
						@atoms.Icon(atoms.IconProps{Kind: atoms.IconKindArrowRight, Class: "h-4 w-4"})
					</a>
				}
			</div>
		</section>
		<section>
			<h2 class="mb-3 text-lg font-bold text-ink-900">{ i18n.T(data.Locale, "home.quick_actions") }</h2>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				for _, action := range data.QuickActions {
					<a class="quick-card" href={ action.Path }>
						<span class="quick-card-icon">
							@atoms.Icon(atoms.IconProps{Kind: atoms.IconKind(action.Icon), Class: "h-5 w-5"})
						</span>
						<span class="min-w-0">
							<span class="block text-sm font-semibold text-ink-900">{ action.Label }</span>
							<span class="mt-0.5 block text-xs leading-relaxed text-ink-500">{ action.Description }</span>
						</span>
					</a>
				}
			</div>
		</section>
		<section class="card card-pad">
			<h2 class="mb-3 text-lg font-bold text-ink-900">{ i18n.T(data.Locale, "home.your_roles") }</h2>
			<div class="flex flex-wrap gap-2">
				for _, role := range data.Roles {
					@atoms.Badge(atoms.BadgeProps{Label: role, Variant: roleBadgeVariant(role)})
				}
			</div>
		</section>
	</div>
}

// roleBadgeVariant maps an RBAC role to the shared badge style.
func roleBadgeVariant(role string) atoms.BadgeVariant {
	switch role {
	case "syndic":
		return atoms.BadgeVariantWarning
	case "tenant":
		return atoms.BadgeVariantNeutral
	default:
		return atoms.BadgeVariantInfo
	}
}
