package templates

import sharedtemplates "github.com/leoarkiteto/zelo/internal/shared/templates"

// QuickAction is a dashboard quick-action card.
type QuickAction struct {
	Icon        string // building | mail | users | home | key
	Label       string
	Description string
	Path        string
}

type DashboardData struct {
	Shell        *sharedtemplates.ShellData
	Greeting     string
	Name         string
	Date         string
	Roles        []string
	QuickActions []QuickAction
}

templ DashboardPage(data DashboardData) {
	@sharedtemplates.Layout("Dashboard", data.Shell, dashboardBody(data))
}

templ dashboardBody(data DashboardData) {
	<div class="space-y-8">
		<section class="rounded-lg border border-steel-200 bg-canvas-blue p-6 md:p-8">
			<p class="text-sm font-medium text-steel-700">{ data.Greeting }, { data.Name }</p>
			<p class="mt-0.5 text-xs text-ink-500">{ data.Date }</p>
			<h1 class="mt-4 text-2xl font-bold tracking-tight text-ink-900">Manage your condominium in one place.</h1>
			<p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-600">
				Access your areas, manage roles and invitations, and keep track of your unit or tenancy — all from one dashboard.
			</p>
			<div class="mt-5">
				if len(data.QuickActions) > 0 {
					<a class="btn btn-primary" href={ data.QuickActions[0].Path }>
						Get started
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
					</a>
				}
			</div>
		</section>

		<section>
			<h2 class="mb-3 text-lg font-bold text-ink-900">Quick actions</h2>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				for _, action := range data.QuickActions {
					<a class="quick-card" href={ action.Path }>
						<span class="quick-card-icon">@QuickActionIcon(action.Icon)</span>
						<span class="min-w-0">
							<span class="block text-sm font-semibold text-ink-900">{ action.Label }</span>
							<span class="mt-0.5 block text-xs leading-relaxed text-ink-500">{ action.Description }</span>
						</span>
					</a>
				}
			</div>
		</section>

		<section class="card card-pad">
			<h2 class="mb-3 text-lg font-bold text-ink-900">Your roles</h2>
			<div class="flex flex-wrap gap-2">
				for _, role := range data.Roles {
					<span class={ sharedtemplates.RoleBadgeClass(role) }>{ role }</span>
				}
			</div>
		</section>
	</div>
}

templ QuickActionIcon(kind string) {
	switch kind {
	case "building":
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14M10 21v-5h4v5"/></svg>
	case "mail":
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm0 0l8 5 8-5"/></svg>
	case "users":
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M15 3.13a4 4 0 0 1 0 7.75"/></svg>
	case "home":
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5M5 9.5V21h14V9.5M10 21v-6h4v6"/></svg>
	case "key":
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="7" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M13 10l8 8M17 14l3 3M19 16l2 2"/></svg>
	default:
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
	}
}
