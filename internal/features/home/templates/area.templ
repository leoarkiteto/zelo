package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

// DashboardLink is a simple labeled link shown on area pages.
type DashboardLink struct {
	Label string
	Path  string
}

type AreaPageData struct {
	Shell   *organisms.ShellData
	Locale  i18n.Language
	Title   string
	Message string
	Links   []DashboardLink
}

templ AreaPage(data AreaPageData) {
	@organisms.Layout(data.Title, data.Locale, data.Shell, areaBody(data))
}

templ areaBody(data AreaPageData) {
	<div class="space-y-4">
		<nav class="breadcrumb" aria-label={ i18n.T(data.Locale, "area.breadcrumb_label") }>
			<a href="/">{ i18n.T(data.Locale, "common.dashboard") }</a>
			@atoms.Icon(atoms.IconProps{Kind: atoms.IconKindChevronLeft, Class: "h-3.5 w-3.5"})
			<span class="font-medium text-ink-700">{ data.Title }</span>
		</nav>
		<div class="card card-pad">
			<h1 class="page-title">{ data.Title }</h1>
			<p class="page-subtitle mb-6">{ data.Message }</p>
			<ul class="space-y-2">
				for _, link := range data.Links {
					<li>
						<a class="flex items-center justify-between rounded-md border border-chrome-200 px-4 py-3 text-sm font-medium text-ink-800 transition-colors hover:border-steel-300 hover:bg-steel-50" href={ link.Path }>
							<span>{ link.Label }</span>
							@atoms.Icon(atoms.IconProps{Kind: atoms.IconKindArrowRight, Class: "h-4 w-4 text-steel-500"})
						</a>
					</li>
				}
			</ul>
		</div>
	</div>
}
