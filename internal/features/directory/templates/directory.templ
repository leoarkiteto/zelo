package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	molecules "github.com/leoarkiteto/zelo/internal/shared/templates/molecules"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type CategoryOption struct {
	ID   string
	Name string
}

type ListingView struct {
	ID           string
	Name         string
	CategoryName string
	Phone        string
	Notes        string
	UnitCode     string
}

type DirectoryPageData struct {
	Shell            *organisms.ShellData
	Locale           i18n.Language
	CSRF             string
	Listings         []ListingView
	Categories       []CategoryOption
	Query            string
	SelectedCategory string
	IsSyndic         bool
	Flash            string
}

type ListingFormValues struct {
	Name       string
	CategoryID string
	Phone      string
	Notes      string
}

type ListingFormData struct {
	Shell            *organisms.ShellData
	Locale           i18n.Language
	CSRF             string
	Categories       []CategoryOption
	Values           ListingFormValues
	IsEdit           bool
	ListingID        string
	Error            string
	DuplicateWarning string
}

type CategoryView struct {
	ID     string
	Name   string
	Active bool
}

type CategoriesPageData struct {
	Shell      *organisms.ShellData
	Locale     i18n.Language
	CSRF       string
	Categories []CategoryView
	Error      string
	Flash      string
}

type DeleteConfirmData struct {
	Shell   *organisms.ShellData
	Locale  i18n.Language
	CSRF    string
	Listing ListingView
	Error   string
}

func listingFormAction(data ListingFormData) string {
	if data.IsEdit {
		return "/directory/" + data.ListingID + "/edit"
	}
	return "/directory"
}

func listingSubmitLabel(data ListingFormData) string {
	if data.IsEdit {
		return i18n.T(data.Locale, "common.save_changes")
	}
	return i18n.T(data.Locale, "directory.add_to_directory")
}

// categoryStatusLabel renders the localized status label for a category.
func categoryStatusLabel(locale i18n.Language, active bool) string {
	if active {
		return i18n.T(locale, "directory.status.active")
	}
	return i18n.T(locale, "directory.status.deactivated")
}

templ DirectoryPage(data DirectoryPageData) {
	@organisms.Layout(i18n.T(data.Locale, "directory.title"), data.Locale, data.Shell, directoryBody(data))
}

templ directoryBody(data DirectoryPageData) {
	<div class="space-y-6">
		<div class="page-head">
			<div>
				<h1 class="page-title">{ i18n.T(data.Locale, "directory.title") }</h1>
				<p class="page-subtitle">{ i18n.T(data.Locale, "directory.subtitle") }</p>
			</div>
			<div class="flex flex-wrap gap-2">
				if data.IsSyndic {
					<a class="btn btn-secondary" href="/directory/categories">{ i18n.T(data.Locale, "directory.manage_categories") }</a>
				}
				<a class="btn btn-primary" href="/directory/new">{ i18n.T(data.Locale, "directory.recommend") }</a>
			</div>
		</div>
		if data.Flash != "" {
			@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantSuccess, Message: data.Flash})
		}
		<form method="GET" action="/directory" class="card card-pad grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:items-end">
			<div>
				<label class="label" for="q">{ i18n.T(data.Locale, "directory.search_label") }</label>
				<input class="input" type="search" id="q" name="q" value={ data.Query } placeholder={ i18n.T(data.Locale, "directory.search_placeholder") }/>
			</div>
			<div>
				<label class="label" for="category">{ i18n.T(data.Locale, "directory.category_label") }</label>
				<select class="select" id="category" name="category">
					<option value="">{ i18n.T(data.Locale, "directory.all_categories") }</option>
					for _, c := range data.Categories {
						<option value={ c.ID } selected={ c.ID == data.SelectedCategory }>{ c.Name }</option>
					}
				</select>
			</div>
			<div class="flex gap-2">
				<button class="btn btn-primary" type="submit">{ i18n.T(data.Locale, "common.search") }</button>
				<a class="btn btn-secondary" href="/directory">{ i18n.T(data.Locale, "common.clear") }</a>
			</div>
		</form>
		<section class="card">
			<div class="border-b border-chrome-200 px-6 py-4">
				<h2 class="text-lg font-bold text-ink-900">{ i18n.T(data.Locale, "directory.listings") }</h2>
			</div>
			if len(data.Listings) == 0 {
				@molecules.EmptyState(molecules.EmptyStateProps{
					Icon:  atoms.IconKindClipboard,
					Title: i18n.T(data.Locale, "directory.empty_title"),
					Copy:  i18n.T(data.Locale, "directory.empty_copy"),
					Action: atoms.Button(atoms.ButtonProps{Label: i18n.T(data.Locale, "directory.recommend"), Variant: atoms.ButtonVariantPrimary, Href: "/directory/new", Class: "btn-sm mt-2"}),
				})
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>{ i18n.T(data.Locale, "directory.col.professional") }</th>
								<th>{ i18n.T(data.Locale, "common.category") }</th>
								<th>{ i18n.T(data.Locale, "common.phone") }</th>
								<th>{ i18n.T(data.Locale, "common.notes") }</th>
								<th>{ i18n.T(data.Locale, "directory.col.recommended_by") }</th>
								if data.IsSyndic {
									<th class="text-right">{ i18n.T(data.Locale, "common.actions") }</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, l := range data.Listings {
								<tr>
									<td class="font-medium text-ink-800">{ l.Name }</td>
									<td>@atoms.Badge(atoms.BadgeProps{Label: l.CategoryName, Variant: atoms.BadgeVariantInfo})</td>
									<td class="text-ink-700">{ l.Phone }</td>
									<td class="text-ink-500">{ l.Notes }</td>
									<td class="text-ink-500">{ i18n.T(data.Locale, "directory.unit_prefix") } { l.UnitCode }</td>
									if data.IsSyndic {
										<td>
											<div class="flex flex-wrap items-center justify-end gap-2">
												<a class="btn btn-secondary btn-sm" href={ templ.URL("/directory/" + l.ID + "/edit") }>{ i18n.T(data.Locale, "common.edit") }</a>
												<a class="btn btn-danger btn-sm" href={ templ.URL("/directory/" + l.ID + "/delete") }>{ i18n.T(data.Locale, "common.delete") }</a>
											</div>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	</div>
}

templ ListingFormPage(data ListingFormData) {
	@organisms.Layout(i18n.T(data.Locale, "directory.recommend"), data.Locale, data.Shell, listingFormBody(data))
}

templ listingFormBody(data ListingFormData) {
	<div class="max-w-2xl space-y-4">
		<div class="page-head">
			<div>
				if data.IsEdit {
					<h1 class="page-title">{ i18n.T(data.Locale, "directory.edit_title") }</h1>
					<p class="page-subtitle">{ i18n.T(data.Locale, "directory.edit_subtitle") }</p>
				} else {
					<h1 class="page-title">{ i18n.T(data.Locale, "directory.new_title") }</h1>
					<p class="page-subtitle">{ i18n.T(data.Locale, "directory.new_subtitle") }</p>
				}
			</div>
		</div>
		if data.Error != "" {
			@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantError, Message: data.Error})
		}
		if data.DuplicateWarning != "" {
			@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantInfo, Message: data.DuplicateWarning})
		}
		<form method="POST" action={ templ.URL(listingFormAction(data)) } class="card card-pad grid gap-4">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			if data.IsEdit {
				<input type="hidden" name="listing_id" value={ data.ListingID }/>
			}
			<div>
				<label class="label" for="name">{ i18n.T(data.Locale, "directory.professional_name") }</label>
				<input class="input" type="text" id="name" name="name" value={ data.Values.Name } required maxlength="120" placeholder={ i18n.T(data.Locale, "directory.placeholder_name") }/>
			</div>
			<div>
				<label class="label" for="category_id">{ i18n.T(data.Locale, "common.category") }</label>
				<select class="select" id="category_id" name="category_id" required>
					for _, c := range data.Categories {
						<option value={ c.ID } selected={ c.ID == data.Values.CategoryID }>{ c.Name }</option>
					}
				</select>
			</div>
			<div>
				<label class="label" for="phone">{ i18n.T(data.Locale, "directory.phone_number") }</label>
				<input class="input" type="tel" id="phone" name="phone" value={ data.Values.Phone } required placeholder="+55 11 91234-5678"/>
			</div>
			<div>
				<label class="label" for="notes">{ i18n.T(data.Locale, "directory.notes_optional") }</label>
				<textarea class="input" id="notes" name="notes" rows="3" maxlength="500">{ data.Values.Notes }</textarea>
			</div>
			if data.DuplicateWarning != "" {
				<div class="flex items-center gap-2">
					<input type="checkbox" id="confirm_duplicate" name="confirm_duplicate" value="1"/>
					<label class="text-sm text-ink-700" for="confirm_duplicate">{ i18n.T(data.Locale, "directory.confirm_duplicate") }</label>
				</div>
			}
			<div class="flex gap-2">
				<button class="btn btn-primary" type="submit">{ listingSubmitLabel(data) }</button>
				<a class="btn btn-secondary" href="/directory">{ i18n.T(data.Locale, "common.cancel") }</a>
			</div>
		</form>
	</div>
}

templ CategoriesPage(data CategoriesPageData) {
	@organisms.Layout(i18n.T(data.Locale, "directory.categories_title"), data.Locale, data.Shell, categoriesBody(data))
}

templ categoriesBody(data CategoriesPageData) {
	<div class="space-y-6">
		<div class="page-head">
			<div>
				<h1 class="page-title">{ i18n.T(data.Locale, "directory.categories_title") }</h1>
				<p class="page-subtitle">{ i18n.T(data.Locale, "directory.categories_subtitle") }</p>
			</div>
			<a class="btn btn-secondary" href="/directory">{ i18n.T(data.Locale, "common.back_to_directory") }</a>
		</div>
		if data.Flash != "" {
			@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantSuccess, Message: data.Flash})
		}
		if data.Error != "" {
			@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantError, Message: data.Error})
		}
		<section class="card card-pad">
			<h2 class="mb-4 text-lg font-bold text-ink-900">{ i18n.T(data.Locale, "directory.add_category_heading") }</h2>
			<form method="POST" action="/directory/categories" class="flex flex-col gap-2 sm:flex-row sm:items-end">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<div class="flex-1">
					<label class="label" for="name">{ i18n.T(data.Locale, "directory.category_name") }</label>
					<input class="input" type="text" id="name" name="name" required maxlength="80" placeholder={ i18n.T(data.Locale, "directory.placeholder_category") }/>
				</div>
				<button class="btn btn-primary" type="submit">{ i18n.T(data.Locale, "directory.add_category") }</button>
			</form>
		</section>
		<section class="card">
			<div class="border-b border-chrome-200 px-6 py-4">
				<h2 class="text-lg font-bold text-ink-900">{ i18n.T(data.Locale, "directory.categories_heading") }</h2>
			</div>
			if len(data.Categories) == 0 {
				@molecules.EmptyState(molecules.EmptyStateProps{
					Icon:  atoms.IconKindTag,
					Title: i18n.T(data.Locale, "directory.categories_empty_title"),
					Copy:  i18n.T(data.Locale, "directory.categories_empty_copy"),
				})
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>{ i18n.T(data.Locale, "common.name") }</th>
								<th>{ i18n.T(data.Locale, "common.status") }</th>
								<th class="text-right">{ i18n.T(data.Locale, "common.actions") }</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range data.Categories {
								<tr>
									<td class="font-medium text-ink-800">{ c.Name }</td>
									<td>
										if c.Active {
											@atoms.Badge(atoms.BadgeProps{Label: categoryStatusLabel(data.Locale, true), Variant: atoms.BadgeVariantSuccess})
										} else {
											@atoms.Badge(atoms.BadgeProps{Label: categoryStatusLabel(data.Locale, false), Variant: atoms.BadgeVariantNeutral})
										}
									</td>
									<td>
										<div class="flex flex-wrap items-center justify-end gap-2">
											<form method="POST" action={ templ.URL("/directory/categories/" + c.ID + "/rename") } class="flex items-center gap-1.5">
												<input type="hidden" name="csrf_token" value={ data.CSRF }/>
												<input class="input" type="text" name="name" value={ c.Name } maxlength="80" aria-label={ i18n.T(data.Locale, "directory.new_name_aria") }/>
												<button class="btn btn-secondary btn-sm" type="submit">{ i18n.T(data.Locale, "directory.rename") }</button>
											</form>
											if c.Active {
												<form method="POST" action={ templ.URL("/directory/categories/" + c.ID + "/deactivate") }>
													<input type="hidden" name="csrf_token" value={ data.CSRF }/>
													<button class="btn btn-danger btn-sm" type="submit">{ i18n.T(data.Locale, "directory.deactivate") }</button>
												</form>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	</div>
}

templ DeleteConfirmPage(data DeleteConfirmData) {
	@organisms.Layout(i18n.T(data.Locale, "directory.delete_title"), data.Locale, data.Shell, deleteConfirmBody(data))
}

templ deleteConfirmBody(data DeleteConfirmData) {
	<div class="max-w-2xl space-y-4">
		<div class="page-head">
			<div>
				<h1 class="page-title">{ i18n.T(data.Locale, "directory.delete_title") }</h1>
				<p class="page-subtitle">{ i18n.T(data.Locale, "directory.delete_subtitle") }</p>
			</div>
		</div>
		@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantError, Message: i18n.T(data.Locale, "directory.delete_warning_1") + " \"" + data.Listing.Name + "\" " + i18n.T(data.Locale, "directory.delete_warning_2")})
		<section class="card card-pad">
			<dl class="grid gap-3 text-sm">
				<div class="grid grid-cols-3 gap-2">
					<dt class="font-medium text-ink-500">{ i18n.T(data.Locale, "directory.col.professional") }</dt>
					<dd class="col-span-2 text-ink-800">{ data.Listing.Name }</dd>
				</div>
				<div class="grid grid-cols-3 gap-2">
					<dt class="font-medium text-ink-500">{ i18n.T(data.Locale, "common.category") }</dt>
					<dd class="col-span-2 text-ink-800">{ data.Listing.CategoryName }</dd>
				</div>
				<div class="grid grid-cols-3 gap-2">
					<dt class="font-medium text-ink-500">{ i18n.T(data.Locale, "common.phone") }</dt>
					<dd class="col-span-2 text-ink-800">{ data.Listing.Phone }</dd>
				</div>
				<div class="grid grid-cols-3 gap-2">
					<dt class="font-medium text-ink-500">{ i18n.T(data.Locale, "directory.col.recommended_by") }</dt>
					<dd class="col-span-2 text-ink-800">{ i18n.T(data.Locale, "directory.unit_prefix") } { data.Listing.UnitCode }</dd>
				</div>
			</dl>
			<form method="POST" action={ templ.URL("/directory/" + data.Listing.ID + "/delete") } class="mt-6 flex gap-2">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<button class="btn btn-danger" type="submit">{ i18n.T(data.Locale, "directory.delete_title") }</button>
				<a class="btn btn-secondary" href="/directory">{ i18n.T(data.Locale, "common.cancel") }</a>
			</form>
		</section>
	</div>
}
