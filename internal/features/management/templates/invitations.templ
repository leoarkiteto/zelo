package templates

import (
	sharedtemplates "github.com/leoarkiteto/zelo/internal/shared/templates"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type UnitOption struct {
	ID   string
	Code string
}

type InvitationView struct {
	ID        string
	UnitCode  string
	Role      string
	Email     string
	Status    string
	ExpiresAt string
}

type InvitationsPageData struct {
	Shell       *sharedtemplates.ShellData
	Locale      i18n.Language
	CSRF        string
	Units       []UnitOption
	Invitations []InvitationView
	Error       string
	Flash       string
}

// invitationStatusLabel renders the localized status label for an invitation.
func invitationStatusLabel(locale i18n.Language, status string) string {
	switch status {
	case "pending":
		return i18n.T(locale, "invitations.status.pending")
	case "used":
		return i18n.T(locale, "invitations.status.used")
	case "revoked":
		return i18n.T(locale, "invitations.status.revoked")
	default:
		return status
	}
}

templ InvitationsPage(data InvitationsPageData) {
	@sharedtemplates.Layout(i18n.T(data.Locale, "invitations.title"), data.Locale, data.Shell, invitationsBody(data))
}

templ invitationsBody(data InvitationsPageData) {
	<div class="space-y-6">
		<div class="page-head">
			<div>
				<h1 class="page-title">{ i18n.T(data.Locale, "invitations.title") }</h1>
				<p class="page-subtitle">{ i18n.T(data.Locale, "invitations.subtitle") }</p>
			</div>
		</div>
		if data.Flash != "" {
			<p class="alert alert-success">{ data.Flash }</p>
		}
		if data.Error != "" {
			<p class="alert alert-error">{ data.Error }</p>
		}

		<section class="card card-pad">
			<h2 class="mb-4 text-lg font-bold text-ink-900">{ i18n.T(data.Locale, "invitations.create_heading") }</h2>
			<form method="POST" action="/invitations" class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 lg:items-end">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<div>
					<label class="label" for="unit_id">{ i18n.T(data.Locale, "common.unit") }</label>
					<select class="select" id="unit_id" name="unit_id" required>
						for _, unit := range data.Units {
							<option value={ unit.ID }>{ unit.Code }</option>
						}
					</select>
				</div>
				<div>
					<label class="label" for="invited_role">{ i18n.T(data.Locale, "common.role") }</label>
					<select class="select" id="invited_role" name="invited_role" required>
						<option value="owner">{ i18n.T(data.Locale, "common.owner") }</option>
						<option value="tenant">{ i18n.T(data.Locale, "common.tenant") }</option>
					</select>
				</div>
				<div>
					<label class="label" for="invited_email">{ i18n.T(data.Locale, "invitations.email_optional") }</label>
					<input class="input" type="email" id="invited_email" name="invited_email" placeholder="person@example.com"/>
				</div>
				<button class="btn btn-primary" type="submit">{ i18n.T(data.Locale, "invitations.create_button") }</button>
			</form>
		</section>

		<section class="card">
			<div class="border-b border-chrome-200 px-6 py-4">
				<h2 class="text-lg font-bold text-ink-900">{ i18n.T(data.Locale, "invitations.recent_heading") }</h2>
			</div>
			if len(data.Invitations) == 0 {
				<div class="empty-state">
					<span class="flex h-12 w-12 items-center justify-center rounded-full bg-chrome-100 text-chrome-400">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm0 0l8 5 8-5"/></svg>
					</span>
					<p class="empty-state-title">{ i18n.T(data.Locale, "invitations.empty_title") }</p>
					<p class="empty-state-copy">{ i18n.T(data.Locale, "invitations.empty_copy") }</p>
				</div>
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>{ i18n.T(data.Locale, "common.unit") }</th>
								<th>{ i18n.T(data.Locale, "common.role") }</th>
								<th>{ i18n.T(data.Locale, "common.email") }</th>
								<th>{ i18n.T(data.Locale, "common.status") }</th>
								<th>{ i18n.T(data.Locale, "invitations.col.expires") }</th>
								<th class="text-right">{ i18n.T(data.Locale, "common.actions") }</th>
							</tr>
						</thead>
						<tbody>
							for _, inv := range data.Invitations {
								<tr>
									<td class="font-medium text-ink-800">{ inv.UnitCode }</td>
									<td><span class={ sharedtemplates.RoleBadgeClass(inv.Role) }>{ inv.Role }</span></td>
									<td class="text-ink-700">{ inv.Email }</td>
									<td><span class={ statusBadgeClass(inv.Status) }>{ invitationStatusLabel(data.Locale, inv.Status) }</span></td>
									<td class="text-ink-500">{ inv.ExpiresAt }</td>
									<td class="text-right">
										if inv.Status == "pending" {
											<form method="POST" action={ templ.URL("/invitations/" + inv.ID + "/revoke") }>
												<input type="hidden" name="csrf_token" value={ data.CSRF }/>
												<button class="btn btn-danger btn-sm" type="submit">{ i18n.T(data.Locale, "invitations.revoke") }</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	</div>
}

// statusBadgeClass maps an invitation status to its badge style.
func statusBadgeClass(status string) string {
	switch status {
	case "pending":
		return "badge badge-warning"
	case "used":
		return "badge badge-info"
	case "revoked":
		return "badge badge-danger"
	default:
		return "badge badge-neutral"
	}
}
