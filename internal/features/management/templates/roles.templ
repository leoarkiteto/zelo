package templates

import sharedtemplates "github.com/leoarkiteto/zelo/internal/shared/templates"

type UserRoleView struct {
	UserID string
	Email  string
	Roles  []string
}

type RolesPageData struct {
	Shell *sharedtemplates.ShellData
	CSRF  string
	Users []UserRoleView
	Error string
}

templ RolesPage(data RolesPageData) {
	@sharedtemplates.Layout("Role management", data.Shell, rolesBody(data))
}

templ rolesBody(data RolesPageData) {
	<div class="space-y-4">
		<div class="page-head">
			<div>
				<h1 class="page-title">Role management</h1>
				<p class="page-subtitle">Assign and revoke roles for users in your condominium.</p>
			</div>
			<a class="btn btn-primary" href="/invitations">Invite user</a>
		</div>
		if data.Error != "" {
			<p class="alert alert-error">{ data.Error }</p>
		}
		<div class="card">
			if len(data.Users) == 0 {
				<div class="empty-state">
					<span class="flex h-12 w-12 items-center justify-center rounded-full bg-chrome-100 text-chrome-400">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M15 3.13a4 4 0 0 1 0 7.75"/></svg>
					</span>
					<p class="empty-state-title">No users yet</p>
					<p class="empty-state-copy">Invite owners and tenants to join your condominium.</p>
					<a class="btn btn-primary btn-sm mt-2" href="/invitations">Invite user</a>
				</div>
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>User</th>
								<th>Roles</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, u := range data.Users {
								<tr>
									<td class="font-medium text-ink-800">{ u.Email }</td>
									<td>
										<div class="flex flex-wrap gap-1.5">
											for _, role := range u.Roles {
												<span class={ sharedtemplates.RoleBadgeClass(role) }>{ role }</span>
											}
										</div>
									</td>
									<td>
										<div class="flex flex-wrap items-center justify-end gap-2">
											<form method="POST" action="/roles/assign" class="flex items-center gap-1.5">
												<input type="hidden" name="csrf_token" value={ data.CSRF }/>
												<input type="hidden" name="user_id" value={ u.UserID }/>
												<select name="role" class="rounded-md border border-chrome-200 bg-white px-2 py-1.5 text-xs text-ink-900 focus:border-steel-500 focus:outline-none" aria-label="Role to grant">
													<option value="owner">owner</option>
													<option value="tenant">tenant</option>
													<option value="syndic">syndic</option>
												</select>
												<button class="btn btn-primary btn-sm" type="submit">Grant</button>
											</form>
											<form method="POST" action="/roles/revoke" class="flex items-center gap-1.5">
												<input type="hidden" name="csrf_token" value={ data.CSRF }/>
												<input type="hidden" name="user_id" value={ u.UserID }/>
												<select name="role" class="rounded-md border border-chrome-200 bg-white px-2 py-1.5 text-xs text-ink-900 focus:border-steel-500 focus:outline-none" aria-label="Role to revoke">
													<option value="owner">owner</option>
													<option value="tenant">tenant</option>
													<option value="syndic">syndic</option>
												</select>
												<button class="btn btn-secondary btn-sm" type="submit">Revoke</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
