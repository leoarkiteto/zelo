package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	molecules "github.com/leoarkiteto/zelo/internal/shared/templates/molecules"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type UserRoleView struct {
	UserID string
	Email  string
	Roles  []string
}

type RolesPageData struct {
	Shell  *organisms.ShellData
	Locale i18n.Language
	CSRF   string
	Users  []UserRoleView
	Error  string
}

templ RolesPage(data RolesPageData) {
	@organisms.Layout(i18n.T(data.Locale, "roles.title"), data.Locale, data.Shell, rolesBody(data))
}

templ rolesBody(data RolesPageData) {
	<div class="space-y-4">
		<div class="page-head">
			<div>
				<h1 class="page-title">{ i18n.T(data.Locale, "roles.title") }</h1>
				<p class="page-subtitle">{ i18n.T(data.Locale, "roles.subtitle") }</p>
			</div>
			<a class="btn btn-primary" href="/invitations">{ i18n.T(data.Locale, "common.invite_user") }</a>
		</div>
		if data.Error != "" {
			@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantError, Message: data.Error})
		}
		<div class="card">
			if len(data.Users) == 0 {
				@molecules.EmptyState(molecules.EmptyStateProps{
					Icon:  atoms.IconKindUsers,
					Title: i18n.T(data.Locale, "roles.empty_title"),
					Copy:  i18n.T(data.Locale, "roles.empty_copy"),
					Action: atoms.Button(atoms.ButtonProps{Label: i18n.T(data.Locale, "common.invite_user"), Variant: atoms.ButtonVariantPrimary, Href: "/invitations", Class: "btn-sm mt-2"}),
				})
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>{ i18n.T(data.Locale, "roles.col.user") }</th>
								<th>{ i18n.T(data.Locale, "roles.col.roles") }</th>
								<th class="text-right">{ i18n.T(data.Locale, "common.actions") }</th>
							</tr>
						</thead>
						<tbody>
							for _, u := range data.Users {
								<tr>
									<td class="font-medium text-ink-800">{ u.Email }</td>
									<td>
										<div class="flex flex-wrap gap-1.5">
											for _, role := range u.Roles {
												@atoms.Badge(atoms.BadgeProps{Label: role, Variant: roleBadgeVariant(role)})
											}
										</div>
									</td>
									<td>
										<div class="flex flex-wrap items-center justify-end gap-2">
											<form method="POST" action="/roles/assign" class="flex items-center gap-1.5">
												<input type="hidden" name="csrf_token" value={ data.CSRF }/>
												<input type="hidden" name="user_id" value={ u.UserID }/>
												<select name="role" class="rounded-md border border-chrome-200 bg-white px-2 py-1.5 text-xs text-ink-900 focus:border-steel-500 focus:outline-none" aria-label={ i18n.T(data.Locale, "roles.grant_aria") }>
													<option value="owner">owner</option>
													<option value="tenant">tenant</option>
													<option value="syndic">syndic</option>
												</select>
												<button class="btn btn-primary btn-sm" type="submit">{ i18n.T(data.Locale, "roles.grant") }</button>
											</form>
											<form method="POST" action="/roles/revoke" class="flex items-center gap-1.5">
												<input type="hidden" name="csrf_token" value={ data.CSRF }/>
												<input type="hidden" name="user_id" value={ u.UserID }/>
												<select name="role" class="rounded-md border border-chrome-200 bg-white px-2 py-1.5 text-xs text-ink-900 focus:border-steel-500 focus:outline-none" aria-label={ i18n.T(data.Locale, "roles.revoke_aria") }>
													<option value="owner">owner</option>
													<option value="tenant">tenant</option>
													<option value="syndic">syndic</option>
												</select>
												<button class="btn btn-secondary btn-sm" type="submit">{ i18n.T(data.Locale, "roles.revoke") }</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}

// roleBadgeVariant maps an RBAC role to the shared badge variant.
func roleBadgeVariant(role string) atoms.BadgeVariant {
	switch role {
	case "syndic":
		return atoms.BadgeVariantWarning
	case "tenant":
		return atoms.BadgeVariantNeutral
	default:
		return atoms.BadgeVariantInfo
	}
}
