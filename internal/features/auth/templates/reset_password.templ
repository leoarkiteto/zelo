package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	molecules "github.com/leoarkiteto/zelo/internal/shared/templates/molecules"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type ResetPasswordPageData struct {
	Token  string
	CSRF   string
	Error  string
	Locale i18n.Language
}

templ ResetPasswordPage(data ResetPasswordPageData) {
	@organisms.Layout(i18n.T(data.Locale, "auth.reset_password"), data.Locale, nil, resetPasswordBody(data))
}

templ resetPasswordBody(data ResetPasswordPageData) {
	@AuthShell(i18n.T(data.Locale, "auth.choose_new_password"), i18n.T(data.Locale, "auth.password_min_hint"), resetPasswordForm(data))
}

templ resetPasswordForm(data ResetPasswordPageData) {
	if data.Error != "" {
		@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantError, Message: data.Error})
	}
	<form method="POST" action="/password/reset" class="space-y-4">
		<input type="hidden" name="token" value={ data.Token }/>
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		@molecules.FormField(molecules.FormFieldProps{Label: i18n.T(data.Locale, "auth.new_password"), For: "password", Control: atoms.TextInput(atoms.InputProps{Type: "password", ID: "password", Name: "password", MinLength: "12", Placeholder: i18n.T(data.Locale, "auth.password_hint"), Autocomplete: "new-password", Required: true})})
		@atoms.Button(atoms.ButtonProps{Label: i18n.T(data.Locale, "auth.set_new_password"), Variant: atoms.ButtonVariantPrimary, Type: "submit", Class: "btn-block"})
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		{ i18n.T(data.Locale, "auth.remembered_it") } <a class="font-medium text-steel-600 hover:text-steel-700" href="/login">{ i18n.T(data.Locale, "auth.sign_in") }</a>
	</p>
}
