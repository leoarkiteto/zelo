package templates

import sharedtemplates "github.com/leoarkiteto/zelo/internal/shared/templates"

type ResetPasswordPageData struct {
	Token string
	CSRF  string
	Error string
}

templ ResetPasswordPage(data ResetPasswordPageData) {
	@sharedtemplates.Layout("Reset password", nil, resetPasswordBody(data))
}

templ resetPasswordBody(data ResetPasswordPageData) {
	@AuthShell("Choose a new password", "Your new password must be at least 12 characters.", resetPasswordForm(data))
}

templ resetPasswordForm(data ResetPasswordPageData) {
	if data.Error != "" {
		<p class="alert alert-error">{ data.Error }</p>
	}
	<form method="POST" action="/password/reset" class="space-y-4">
		<input type="hidden" name="token" value={ data.Token }/>
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		<div>
			<label class="label" for="password">New password</label>
			<input class="input" type="password" id="password" name="password" minlength="12" placeholder="At least 12 characters" autocomplete="new-password" required/>
		</div>
		<button class="btn btn-primary btn-block" type="submit">Set new password</button>
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		Remembered it? <a class="font-medium text-steel-600 hover:text-steel-700" href="/login">Sign in</a>
	</p>
}
