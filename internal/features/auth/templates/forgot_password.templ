package templates

import (
	sharedtemplates "github.com/leoarkiteto/zelo/internal/shared/templates"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type ForgotPasswordPageData struct {
	CSRF   string
	Sent   bool
	Error  string
	Locale i18n.Language
}

templ ForgotPasswordPage(data ForgotPasswordPageData) {
	@sharedtemplates.Layout(i18n.T(data.Locale, "auth.reset_password"), data.Locale, nil, forgotPasswordBody(data))
}

templ forgotPasswordBody(data ForgotPasswordPageData) {
	@AuthShell(i18n.T(data.Locale, "auth.forgot_heading"), i18n.T(data.Locale, "auth.forgot_subtitle"), forgotPasswordForm(data))
}

templ forgotPasswordForm(data ForgotPasswordPageData) {
	if data.Sent {
		<p class="alert alert-success">{ i18n.T(data.Locale, "auth.reset_sent") }</p>
	}
	if data.Error != "" {
		<p class="alert alert-error">{ data.Error }</p>
	}
	<form method="POST" action="/password/forgot" class="space-y-4">
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		<div>
			<label class="label" for="email">{ i18n.T(data.Locale, "auth.email") }</label>
			<input class="input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required/>
		</div>
		<button class="btn btn-primary btn-block" type="submit">{ i18n.T(data.Locale, "auth.send_reset_link") }</button>
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		{ i18n.T(data.Locale, "auth.remembered_it") } <a class="font-medium text-steel-600 hover:text-steel-700" href="/login">{ i18n.T(data.Locale, "auth.sign_in") }</a>
	</p>
}
