package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	molecules "github.com/leoarkiteto/zelo/internal/shared/templates/molecules"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type ForgotPasswordPageData struct {
	CSRF   string
	Sent   bool
	Error  string
	Locale i18n.Language
}

templ ForgotPasswordPage(data ForgotPasswordPageData) {
	@organisms.Layout(i18n.T(data.Locale, "auth.reset_password"), data.Locale, nil, forgotPasswordBody(data))
}

templ forgotPasswordBody(data ForgotPasswordPageData) {
	@AuthShell(i18n.T(data.Locale, "auth.forgot_heading"), i18n.T(data.Locale, "auth.forgot_subtitle"), forgotPasswordForm(data))
}

templ forgotPasswordForm(data ForgotPasswordPageData) {
	if data.Sent {
		@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantSuccess, Message: i18n.T(data.Locale, "auth.reset_sent")})
	}
	if data.Error != "" {
		@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantError, Message: data.Error})
	}
	<form method="POST" action="/password/forgot" class="space-y-4">
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		@molecules.FormField(molecules.FormFieldProps{Label: i18n.T(data.Locale, "auth.email"), For: "email", Control: atoms.TextInput(atoms.InputProps{Type: "email", ID: "email", Name: "email", Placeholder: "you@example.com", Autocomplete: "email", Required: true})})
		@atoms.Button(atoms.ButtonProps{Label: i18n.T(data.Locale, "auth.send_reset_link"), Variant: atoms.ButtonVariantPrimary, Type: "submit", Class: "btn-block"})
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		{ i18n.T(data.Locale, "auth.remembered_it") } <a class="font-medium text-steel-600 hover:text-steel-700" href="/login">{ i18n.T(data.Locale, "auth.sign_in") }</a>
	</p>
}
