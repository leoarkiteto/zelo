package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	molecules "github.com/leoarkiteto/zelo/internal/shared/templates/molecules"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type LoginPageData struct {
	CSRF   string
	Error  string
	Locale i18n.Language
}

templ LoginPage(data LoginPageData) {
	@organisms.Layout(i18n.T(data.Locale, "auth.sign_in"), data.Locale, nil, loginBody(data))
}

templ loginBody(data LoginPageData) {
	@AuthShell(i18n.T(data.Locale, "auth.sign_in_title"), i18n.T(data.Locale, "auth.welcome_back"), loginForm(data))
}

templ loginForm(data LoginPageData) {
	if data.Error != "" {
		@molecules.Alert(molecules.AlertProps{Variant: molecules.AlertVariantError, Message: data.Error})
	}
	<form method="POST" action="/login" class="space-y-4">
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		@molecules.FormField(molecules.FormFieldProps{Label: i18n.T(data.Locale, "auth.email"), For: "email", Control: atoms.TextInput(atoms.InputProps{Type: "email", ID: "email", Name: "email", Placeholder: "you@example.com", Autocomplete: "email", Required: true})})
		<div>
			<label class="label" for="password">{ i18n.T(data.Locale, "auth.password") }</label>
			// The reveal control is client-local state (Alpine), not a server
			// request: htmx has nothing to fetch here, and Tailwind CSS cannot
			// swap an input between password and text. Every directive below is
			// deliberately a bare identifier — see web/static/js/app.js for why
			// (the CSP build) — and the static type/aria attributes remain as
			// the server-rendered fallback for the pre-init and no-JS cases.
			<div class="relative" style="position:relative" x-data="passwordToggle" data-label-show={ i18n.T(data.Locale, "auth.show_password") } data-label-hide={ i18n.T(data.Locale, "auth.hide_password") }>
				<input class="input pr-10" style="padding-right:2.5rem" type="password" x-bind:type="inputType" id="password" name="password" placeholder={ i18n.T(data.Locale, "auth.password_placeholder") } autocomplete="current-password" required/>
				<button type="button" x-on:click="toggle" aria-label={ i18n.T(data.Locale, "auth.show_password") } x-bind:aria-label="toggleLabel" aria-pressed="false" x-bind:aria-pressed="pressed" class="absolute inset-y-0 right-0 flex w-10 items-center justify-center text-ink-400 transition-colors hover:text-ink-600" style="position:absolute;top:0;right:0;bottom:0;width:2.5rem;display:flex;align-items:center;justify-content:center">
					<span x-show="eyeVisible">
						@atoms.Icon(atoms.IconProps{Kind: atoms.IconKindEye, Class: "h-5 w-5", DataIcon: "eye"})
					</span>
					<span x-show="eyeOffVisible" style="display:none;">
						@atoms.Icon(atoms.IconProps{Kind: atoms.IconKindEyeOff, Class: "h-5 w-5", DataIcon: "eye-off"})
					</span>
				</button>
			</div>
		</div>
		@atoms.Button(atoms.ButtonProps{Label: i18n.T(data.Locale, "auth.sign_in"), Variant: atoms.ButtonVariantPrimary, Type: "submit", Class: "btn-block"})
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		{ i18n.T(data.Locale, "auth.forgot_password") } <a class="font-medium text-steel-600 hover:text-steel-700" href="/password/forgot">{ i18n.T(data.Locale, "auth.reset_link") }</a>
	</p>
}
