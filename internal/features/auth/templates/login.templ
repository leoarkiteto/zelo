package templates

import (
	sharedtemplates "github.com/leoarkiteto/zelo/internal/shared/templates"

	"github.com/leoarkiteto/zelo/internal/shared/i18n"
)

type LoginPageData struct {
	CSRF   string
	Error  string
	Locale i18n.Language
}

templ LoginPage(data LoginPageData) {
	@sharedtemplates.Layout(i18n.T(data.Locale, "auth.sign_in"), data.Locale, nil, loginBody(data))
}

templ loginBody(data LoginPageData) {
	@AuthShell(i18n.T(data.Locale, "auth.sign_in_title"), i18n.T(data.Locale, "auth.welcome_back"), loginForm(data))
}

templ loginForm(data LoginPageData) {
	if data.Error != "" {
		<p class="alert alert-error">{ data.Error }</p>
	}
	<form method="POST" action="/login" class="space-y-4">
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		<div>
			<label class="label" for="email">{ i18n.T(data.Locale, "auth.email") }</label>
			<input class="input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required/>
		</div>
		<div>
			<label class="label" for="password">{ i18n.T(data.Locale, "auth.password") }</label>
			<div class="relative" style="position:relative">
				<input class="input pr-10" style="padding-right:2.5rem" type="password" id="password" name="password" placeholder={ i18n.T(data.Locale, "auth.password_placeholder") } autocomplete="current-password" required/>
				<button type="button" data-password-toggle="#password" aria-label={ i18n.T(data.Locale, "auth.show_password") } aria-pressed="false" class="absolute inset-y-0 right-0 flex w-10 items-center justify-center text-ink-400 transition-colors hover:text-ink-600" style="position:absolute;top:0;right:0;bottom:0;width:2.5rem;display:flex;align-items:center;justify-content:center">
					<svg class="h-5 w-5" style="width:1.25rem;height:1.25rem" data-icon="eye" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
						<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
					</svg>
					<svg class="h-5 w-5" style="display:none;width:1.25rem;height:1.25rem" data-icon="eye-off" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/>
					</svg>
				</button>
			</div>
		</div>
		<button class="btn btn-primary btn-block" type="submit">{ i18n.T(data.Locale, "auth.sign_in") }</button>
	</form>
	<script>
		(function () {
			document.addEventListener("click", function (event) {
				var btn = event.target.closest("[data-password-toggle]");
				if (!btn) return;
				var input = document.querySelector(btn.getAttribute("data-password-toggle"));
				if (!input) return;
				var show = input.type === "password";
				input.type = show ? "text" : "password";
				btn.setAttribute("aria-pressed", show ? "true" : "false");
				btn.setAttribute("aria-label", show ? "Hide password" : "Show password");
				var eye = btn.querySelector('[data-icon="eye"]');
				var eyeOff = btn.querySelector('[data-icon="eye-off"]');
				if (eye) eye.style.display = show ? "none" : "";
				if (eyeOff) eyeOff.style.display = show ? "" : "none";
			});
		})();
	</script>
	<p class="mt-4 text-center text-sm text-ink-500">
		{ i18n.T(data.Locale, "auth.forgot_password") } <a class="font-medium text-steel-600 hover:text-steel-700" href="/password/forgot">{ i18n.T(data.Locale, "auth.reset_link") }</a>
	</p>
}
