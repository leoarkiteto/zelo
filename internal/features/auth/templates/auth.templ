package templates

// AuthShell is the shared centered layout for public (unauthenticated) pages.
templ AuthShell(title string, subtitle string, body templ.Component) {
	<div class="flex min-h-screen items-center justify-center px-4 py-10">
		<div class="w-full max-w-md">
			<div class="mb-6 flex flex-col items-center gap-3 text-center">
				<a href="/login" class="flex h-12 w-12 items-center justify-center rounded-xl bg-steel-500 text-xl font-bold text-white">Z</a>
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-ink-900">{ title }</h1>
					<p class="mt-1 text-sm text-ink-500">{ subtitle }</p>
				</div>
			</div>
			<div class="card card-pad">
				@body
			</div>
		</div>
	</div>
}
