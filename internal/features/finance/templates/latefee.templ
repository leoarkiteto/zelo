package templates

import (
	atoms "github.com/leoarkiteto/zelo/internal/shared/templates/atoms"
	molecules "github.com/leoarkiteto/zelo/internal/shared/templates/molecules"
	"github.com/leoarkiteto/zelo/internal/shared/i18n"
	organisms "github.com/leoarkiteto/zelo/internal/shared/templates/organisms"
)

// DebtorsPage lists the units with overdue receivables (syndic only, FR-1).
templ DebtorsPage(data DebtorsPageData) {
	@organisms.Layout(i18n.T(data.Locale, "quotas.debtors.title"), data.Locale, data.Shell, debtorsBody(data))
}

templ debtorsBody(data DebtorsPageData) {
	<div class="space-y-4">
		<nav class="breadcrumb" aria-label="breadcrumb">
			<a href="/finance">{ i18n.T(data.Locale, "finance.title") }</a>
			@atoms.Icon(atoms.IconProps{Kind: atoms.IconKindChevronLeft, Class: "h-4 w-4"})
			<a href="/finance/debtors">{ i18n.T(data.Locale, "quotas.debtors.title") }</a>
		</nav>
		<div class="page-head">
			<div>
				<h1 class="page-title">{ i18n.T(data.Locale, "quotas.debtors.title") }</h1>
				<p class="page-subtitle">{ i18n.T(data.Locale, "quotas.debtors.subtitle") }</p>
			</div>
		</div>
		<div class="card">
			if len(data.Rows) == 0 {
				@molecules.EmptyState(molecules.EmptyStateProps{
					Title: i18n.T(data.Locale, "quotas.debtors.empty_title"),
					Copy:  i18n.T(data.Locale, "quotas.debtors.empty_copy"),
				})
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>{ i18n.T(data.Locale, "quotas.debtors.col.unit") }</th>
								<th>{ i18n.T(data.Locale, "quotas.debtors.col.occupants") }</th>
								<th class="text-right">{ i18n.T(data.Locale, "quotas.debtors.col.count") }</th>
								<th class="text-right">{ i18n.T(data.Locale, "quotas.debtors.col.total") }</th>
								<th>{ i18n.T(data.Locale, "quotas.debtors.col.oldest") }</th>
								<th class="text-right">{ i18n.T(data.Locale, "quotas.debtors.col.days") }</th>
								<th class="text-right">{ i18n.T(data.Locale, "quotas.debtors.col.estimated") }</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range data.Rows {
								<tr>
									<td class="font-medium text-ink-800">
										<a class="text-steel-700 underline hover:text-steel-900" href={ templ.URL(r.StatementHref) }>{ r.UnitCode }</a>
									</td>
									<td class="text-ink-700">
										if len(r.Occupants) == 0 {
											<span class="text-ink-500">{ i18n.T(data.Locale, "quotas.debtors.no_occupants") }</span>
										} else {
											<ul>
												for _, o := range r.Occupants {
													<li>{ o }</li>
												}
											</ul>
										}
									</td>
									<td class="text-right text-ink-700">{ itoa(r.OverdueCount) }</td>
									<td class="text-right font-medium text-red-700">{ r.Total }</td>
									<td class="text-ink-700">{ r.OldestDue }</td>
									<td class="text-right text-ink-700">{ itoa(r.DaysLate) }</td>
									<td class="text-right text-ink-700">{ r.Estimated }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@molecules.Pagination(data.Pagination)
			}
		</div>
	</div>
}

// reserveCard shows the reserve fund balance (syndic only, FR-17) with three figures.
templ reserveCard(locale i18n.Language, r *ReserveView) {
	if r != nil {
		<section class="card card-pad" aria-labelledby="reserve-fund-heading" data-reserve-fund="card">
			<h2 id="reserve-fund-heading" class="text-lg font-bold text-ink-900">{ i18n.T(locale, "quotas.reserve_fund.title") }</h2>
			<dl class="mt-3 grid gap-4 md:grid-cols-3">
				<div>
					<dt class="text-sm text-ink-500">{ i18n.T(locale, "quotas.reserve_fund.realized") }</dt>
					<dd class="text-2xl font-bold text-ink-900">{ r.Realized }</dd>
				</div>
				<div>
					<dt class="text-sm text-ink-500">{ i18n.T(locale, "quotas.reserve_fund.forecast") }</dt>
					<dd class="text-2xl font-bold text-ink-900">{ r.Forecast }</dd>
				</div>
				<div>
					<dt class="text-sm text-ink-500">{ i18n.T(locale, "quotas.reserve_fund.realized_year") }</dt>
					<dd class="text-2xl font-bold text-ink-900">{ r.RealizedYear }</dd>
				</div>
			</dl>
		</section>
	}
}
