# Environment configuration template — copy to .env and fill in real values.
# Read by internal/config.

DATABASE_URL=postgres://zelo:zelo@localhost:5432/zelo?sslmode=disable
SESSION_SECRET=replace-with-32-random-bytes
PASSWORD_PEPPER=replace-with-32-random-bytes
APP_ENV=development
HTTP_ADDR=:8080
# Directory where finance receipt attachments are stored (never committed).
UPLOAD_DIR=uploads
