package templates

type ForgotPasswordPageData struct {
	CSRF  string
	Sent  bool
	Error string
}

templ ForgotPasswordPage(data ForgotPasswordPageData) {
	@Layout("Reset password", nil, forgotPasswordBody(data))
}

templ forgotPasswordBody(data ForgotPasswordPageData) {
	@AuthShell("Reset your password", "We will email you a link to choose a new one.", forgotPasswordForm(data))
}

templ forgotPasswordForm(data ForgotPasswordPageData) {
	if data.Sent {
		<p class="alert alert-success">If that email exists, a reset link has been sent.</p>
	}
	if data.Error != "" {
		<p class="alert alert-error">{ data.Error }</p>
	}
	<form method="POST" action="/password/forgot" class="space-y-4">
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		<div>
			<label class="label" for="email">Email</label>
			<input class="input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required/>
		</div>
		<button class="btn btn-primary btn-block" type="submit">Send reset link</button>
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		Remembered it? <a class="font-medium text-steel-600 hover:text-steel-700" href="/login">Sign in</a>
	</p>
}
