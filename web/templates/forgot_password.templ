package templates

type ForgotPasswordPageData struct {
	CSRF  string
	Sent  bool
	Error string
}

templ ForgotPasswordPage(data ForgotPasswordPageData) {
	@Layout("Reset password", forgotPasswordBody(data))
}

templ forgotPasswordBody(data ForgotPasswordPageData) {
	<div class="max-w-md mx-auto mt-16 p-6 bg-white rounded-lg shadow">
		<h1 class="text-2xl font-bold mb-4">Reset password</h1>
		if data.Sent {
			<p class="text-green-600 text-sm mb-3">If that email exists, a reset link has been sent.</p>
		}
		if data.Error != "" {
			<p class="text-red-600 text-sm mb-3">{ data.Error }</p>
		}
		<form method="POST" action="/password/forgot" class="space-y-4">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<div>
				<label class="block text-sm font-medium mb-1" for="email">Email</label>
				<input class="w-full border rounded px-3 py-2" type="email" id="email" name="email" required/>
			</div>
			<button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded" type="submit">Send reset link</button>
		</form>
	</div>
}
