package templates

type ResetPasswordPageData struct {
	Token string
	CSRF  string
	Error string
}

templ ResetPasswordPage(data ResetPasswordPageData) {
	@Layout("Reset password", resetPasswordBody(data))
}

templ resetPasswordBody(data ResetPasswordPageData) {
	<div class="max-w-md mx-auto mt-16 p-6 bg-white rounded-lg shadow">
		<h1 class="text-2xl font-bold mb-4">Choose a new password</h1>
		if data.Error != "" {
			<p class="text-red-600 text-sm mb-3">{ data.Error }</p>
		}
		<form method="POST" action="/password/reset" class="space-y-4">
			<input type="hidden" name="token" value={ data.Token }/>
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<div>
				<label class="block text-sm font-medium mb-1" for="password">New password</label>
				<input class="w-full border rounded px-3 py-2" type="password" id="password" name="password" minlength="12" required/>
			</div>
			<button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded" type="submit">Set new password</button>
		</form>
	</div>
}
