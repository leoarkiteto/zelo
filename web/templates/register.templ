package templates

type RegisterPageData struct {
	Token        string
	InvitedEmail string
	InvitedRole  string
	CSRF         string
	Error        string
}

templ RegisterPage(data RegisterPageData) {
	@Layout("Register", nil, registerBody(data))
}

templ registerBody(data RegisterPageData) {
	@AuthShell("Create your account", "Complete your registration to join the condominium.", registerForm(data))
}

templ registerForm(data RegisterPageData) {
	if data.Error != "" {
		<p class="alert alert-error">{ data.Error }</p>
	}
	<form method="POST" action="/register" class="space-y-4">
		<input type="hidden" name="token" value={ data.Token }/>
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		<div>
			<label class="label" for="email">Email</label>
			<input class="input" type="email" id="email" name="email" value={ data.InvitedEmail } placeholder="you@example.com" autocomplete="email" required/>
		</div>
		<div>
			<label class="label" for="password">Password</label>
			<input class="input" type="password" id="password" name="password" minlength="12" placeholder="At least 12 characters" autocomplete="new-password" required/>
		</div>
		<div>
			<label class="label" for="password_confirm">Confirm password</label>
			<input class="input" type="password" id="password_confirm" name="password_confirm" minlength="12" placeholder="Repeat your password" autocomplete="new-password" required/>
		</div>
		<button class="btn btn-primary btn-block" type="submit">Register</button>
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		Invited as <span class={ roleBadgeClass(data.InvitedRole) }>{ data.InvitedRole }</span>
	</p>
}
