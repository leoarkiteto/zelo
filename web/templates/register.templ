package templates

type RegisterPageData struct {
	Token        string
	InvitedEmail string
	InvitedRole  string
	CSRF         string
	Error        string
}

templ RegisterPage(data RegisterPageData) {
	@Layout("Register", registerBody(data))
}

templ registerBody(data RegisterPageData) {
	<div class="max-w-md mx-auto mt-16 p-6 bg-white rounded-lg shadow">
		<h1 class="text-2xl font-bold mb-1">Create your account</h1>
		<p class="text-sm text-gray-600 mb-4">Invited as: { data.InvitedRole }</p>
		if data.Error != "" {
			<p class="text-red-600 text-sm mb-3">{ data.Error }</p>
		}
		<form method="POST" action="/register" class="space-y-4">
			<input type="hidden" name="token" value={ data.Token }/>
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<div>
				<label class="block text-sm font-medium mb-1" for="email">Email</label>
				<input class="w-full border rounded px-3 py-2" type="email" id="email" name="email" value={ data.InvitedEmail } required/>
			</div>
			<div>
				<label class="block text-sm font-medium mb-1" for="password">Password</label>
				<input class="w-full border rounded px-3 py-2" type="password" id="password" name="password" minlength="12" required/>
			</div>
			<div>
				<label class="block text-sm font-medium mb-1" for="password_confirm">Confirm password</label>
				<input class="w-full border rounded px-3 py-2" type="password" id="password_confirm" name="password_confirm" minlength="12" required/>
			</div>
			<button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded" type="submit">Register</button>
		</form>
	</div>
}
