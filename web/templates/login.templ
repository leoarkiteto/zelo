package templates

type LoginPageData struct {
	CSRF  string
	Error string
}

templ LoginPage(data LoginPageData) {
	@Layout("Sign in", loginBody(data))
}

templ loginBody(data LoginPageData) {
	<div class="max-w-md mx-auto mt-16 p-6 bg-white rounded-lg shadow">
		<h1 class="text-2xl font-bold mb-4">Sign in</h1>
		if data.Error != "" {
			<p class="text-red-600 text-sm mb-3">{ data.Error }</p>
		}
		<form method="POST" action="/login" class="space-y-4">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<div>
				<label class="block text-sm font-medium mb-1" for="email">Email</label>
				<input class="w-full border rounded px-3 py-2" type="email" id="email" name="email" required/>
			</div>
			<div>
				<label class="block text-sm font-medium mb-1" for="password">Password</label>
				<input class="w-full border rounded px-3 py-2" type="password" id="password" name="password" required/>
			</div>
			<button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded" type="submit">Sign in</button>
		</form>
		<p class="mt-4 text-sm"><a class="text-blue-600" href="/password/forgot">Forgot password?</a></p>
	</div>
}
