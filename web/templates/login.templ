package templates

type LoginPageData struct {
	CSRF  string
	Error string
}

templ LoginPage(data LoginPageData) {
	@Layout("Sign in", nil, loginBody(data))
}

templ loginBody(data LoginPageData) {
	@AuthShell("Sign in to your account", "Welcome back — manage your condominium.", loginForm(data))
}

templ loginForm(data LoginPageData) {
	if data.Error != "" {
		<p class="alert alert-error">{ data.Error }</p>
	}
	<form method="POST" action="/login" class="space-y-4">
		<input type="hidden" name="csrf_token" value={ data.CSRF }/>
		<div>
			<label class="label" for="email">Email</label>
			<input class="input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required/>
		</div>
		<div>
			<label class="label" for="password">Password</label>
			<input class="input" type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required/>
		</div>
		<button class="btn btn-primary btn-block" type="submit">Sign in</button>
	</form>
	<p class="mt-4 text-center text-sm text-ink-500">
		Forgot your password? <a class="font-medium text-steel-600 hover:text-steel-700" href="/password/forgot">Reset it</a>
	</p>
}
