package templates

type UnitOption struct {
	ID   string
	Code string
}

type InvitationView struct {
	ID        string
	UnitCode  string
	Role      string
	Email     string
	Status    string
	ExpiresAt string
}

type InvitationsPageData struct {
	CSRF        string
	Units       []UnitOption
	Invitations []InvitationView
	Error       string
	Flash       string
}

templ InvitationsPage(data InvitationsPageData) {
	@Layout("Invitations", invitationsBody(data))
}

templ invitationsBody(data InvitationsPageData) {
	<div class="max-w-3xl mx-auto mt-12 p-6 bg-white rounded-lg shadow">
		<h1 class="text-2xl font-bold mb-6">Invitations</h1>
		if data.Error != "" {
			<p class="text-red-600 text-sm mb-3">{ data.Error }</p>
		}
		if data.Flash != "" {
			<p class="text-green-600 text-sm mb-3">{ data.Flash }</p>
		}
		<form method="POST" action="/invitations" class="space-y-4 mb-8 border-b pb-6">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<div>
				<label class="block text-sm font-medium mb-1" for="unit_id">Unit</label>
				<select class="w-full border rounded px-3 py-2" id="unit_id" name="unit_id" required>
					for _, unit := range data.Units {
						<option value={ unit.ID }>{ unit.Code }</option>
					}
				</select>
			</div>
			<div>
				<label class="block text-sm font-medium mb-1" for="invited_role">Role</label>
				<select class="w-full border rounded px-3 py-2" id="invited_role" name="invited_role" required>
					<option value="owner">Owner</option>
					<option value="tenant">Tenant</option>
				</select>
			</div>
			<div>
				<label class="block text-sm font-medium mb-1" for="invited_email">Email (optional)</label>
				<input class="w-full border rounded px-3 py-2" type="email" id="invited_email" name="invited_email"/>
			</div>
			<button class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded" type="submit">Create invitation</button>
		</form>
		<table class="w-full text-sm">
			<thead>
				<tr class="text-left border-b">
					<th class="py-2">Unit</th>
					<th>Role</th>
					<th>Email</th>
					<th>Status</th>
					<th>Expires</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, inv := range data.Invitations {
					<tr class="border-b">
						<td class="py-2">{ inv.UnitCode }</td>
						<td>{ inv.Role }</td>
						<td>{ inv.Email }</td>
						<td>{ inv.Status }</td>
						<td>{ inv.ExpiresAt }</td>
						<td>
							if inv.Status == "pending" {
								<form method="POST" action={ templ.URL("/invitations/" + inv.ID + "/revoke") }>
									<input type="hidden" name="csrf_token" value={ data.CSRF }/>
									<button class="text-red-600" type="submit">Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
